<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yagmurpazi.testpulse</groupId>
        <artifactId>testpulse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>event-contracts</artifactId>
    <name>TestPulse :: Event Contracts</name>
    <description>Kafka event schemas shared by all services. Plain Java, no framework dependencies.</description>

    <properties>
        <!-- Less logic than the services; values measured in CI, see docs/testing.md -->
        <coverage.line.minimum>0.85</coverage.line.minimum>
        <coverage.branch.minimum>0.70</coverage.branch.minimum>
    </properties>

    <dependencies>
        <!-- Test only: verifies the JSON wire format. The contracts themselves stay dependency free. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
