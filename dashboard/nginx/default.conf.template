# Rendered by the nginx image at startup: ${ANALYSIS_URL} is replaced by the environment variable.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Applies to every response below, because no location adds headers of its own
    # (an add_header inside a location would silently drop these).
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same origin for the page and the API: the browser needs no CORS, and the services stay unexposed.
    location /api/ {
        # Docker's DNS, re-resolved every 10 s: a restarted analysis-service gets a new IP address.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $analysis ${ANALYSIS_URL};
        proxy_pass $analysis;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite puts a content hash in every asset name, so assets can be cached forever...
    location /assets/ {
        expires max;
    }

    # ...while index.html, which references them, must always be revalidated.
    location = /index.html {
        expires -1;
    }

    # Client-side routes such as /tests/{id} are served by the single page app.
    location / {
        try_files $uri /index.html;
    }
}
